{
  "schemaVersion": 1,
  "id": "notchcurrency",
  "version": "${version}",
  "name": "Notch Currency",
  "description": "A server-side economy mod: currency, banking, player shops, an auction house, a deep customizable NPC system, and a full suite of economy roles, sinks, and faucets.",
  "authors": [ "FugginBeenus" ],
  "contact": {
    "homepage": "https://modrinth.com/project/notches-currency",
    "sources": "https://github.com/FugginBeenus/notch-currency-fabric",
    "issues": "https://github.com/FugginBeenus/notch-currency-fabric/issues"
  },
  "license": "MIT",
  "icon": "assets/notchcurrency/textures/notch_icon.png",
  "environment": "*",
  "entrypoints": {
    "main":   [ "net.fugginbeenus.notchcurrency.core.NotchCurrency" ],
    "client": [ "net.fugginbeenus.notchcurrency.client.ClientInit" ],
    "modmenu": [ "net.fugginbeenus.notchcurrency.config.ui.NotchModMenu" ]
  },
  "mixins": [ "notchcurrency.mixins.json" ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "fabric-api": "*",
    "minecraft": "~1.20.1",
    "geckolib": ">=4.4"
  },
  "suggests": {
    "modmenu": "*",
    "waystones": "*"
  }
}
